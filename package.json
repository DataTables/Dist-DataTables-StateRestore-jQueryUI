{
    "name": "datatables.net-staterestore-jqui",
    "description": "StateRestore for DataTables with styling for [jQueryUI](http://jqueryui.com/)",
    "main": "./js/stateRestore.jqueryui.js",
    "module": "./js/stateRestore.jqueryui.mjs",
    "style": "./css/stateRestore.jqueryui.css",
    "types": "./types/stateRestore.jqueryui.d.ts",
    "version": "2.0.1",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "StateRestore",
        "stateSave",
        "state",
        "reload",
        "jQuery UI",
        "jQueryUI",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-staterestore": "2.0.1",
        "datatables.net-jqui": "^3"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DataTables/StateRestore.git"
    },
    "exports": {
        ".": {
            "types": "./types/stateRestore.jqueryui.d.ts",
            "import": "./js/stateRestore.jqueryui.mjs",
            "default": "./js/stateRestore.jqueryui.mjs",
            "require": "./js/stateRestore.jqueryui.js"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/stateRestore.jqueryui.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}